###
# =====================================================================
# AWS ECR Pull Demo - IntelliJ HTTP Client
# - 실제 데모 프로젝트 API만 테스트
# - 포함 기능:
#   0) Docker health
#   1) ECR repo 전체 + 최신 tag 조회 (pull 가능한 repo만 자동 선택)
#   2) ECR pull
#   3) (추가) 로컬 이미지 목록 조회
#   4) (추가) 로컬 이미지 삭제
# =====================================================================

###
# ---------------------------------------------------------------------
# 0) Docker 동작 확인 (필수)
# ---------------------------------------------------------------------
# @name dockerHealth
GET {{host}}/api/health/docker
Accept: application/json

###
# ---------------------------------------------------------------------
# 1) 모든 Repository + 각 repo 최신 tag 조회 (필수)
#    - pullable=true && latestTag!=null 인 repo를 자동 선택
# ---------------------------------------------------------------------
# @name listReposWithLatestTag
POST {{host}}/api/ecr/repositories
Content-Type: application/json
Accept: application/json

{
  "region": "{{region}}",
  "accountId": "{{accountId}}",
  "accessKeyId": "{{accessKeyId}}",
  "secretAccessKey": "{{secretAccessKey}}"
}

> {%
    const items = response.body.items || [];
    client.log("repo count = " + (response.body.count ?? items.length));

    // pull 가능한 repo만 필터
    const candidates = items.filter(it => it && it.pullable === true && it.latestTag);

    if (candidates.length === 0) {
        client.log("❌ No PULLABLE repositories found.");
        client.log("   - All repos may be empty (no images), scan limited, or tags missing.");
        client.global.set("repositoryName", "");
        client.global.set("tag", "");
    } else {
        // 기본: 첫 번째 pull 가능 repo 선택
        const picked = candidates[0];

        client.global.set("repositoryName", picked.repositoryName);
        client.global.set("tag", picked.latestTag);

        client.log("✅ Picked repositoryName = " + picked.repositoryName);
        client.log("✅ Picked tag            = " + picked.latestTag);
        client.log("   repositoryUri         = " + (picked.repositoryUri || ""));
        client.log("   lastPushedAt          = " + (picked.lastPushedAt || ""));
    }
%}

@repositoryName = {{client.global.repositoryName}}
@tag = {{client.global.tag}}

###
# ---------------------------------------------------------------------
# 2) ECR Pull 실행 (필수)
#    - 1번에서 선택된 repositoryName/tag 사용
# ---------------------------------------------------------------------
# @name pullImage
POST {{host}}/api/ecr/pull
Content-Type: application/json
Accept: application/json

{
  "region": "{{region}}",
  "accountId": "{{accountId}}",
  "accessKeyId": "{{accessKeyId}}",
  "secretAccessKey": "{{secretAccessKey}}",
  "repositoryName": "{{repositoryName}}",
  "tag": "{{tag}}"
}

> {%
    client.log("imageRef    = " + response.body.imageRef);
    client.log("resolvedTag = " + response.body.resolvedTag);
    client.log("digest      = " + response.body.digest);
    client.log("message     = " + response.body.message);

    // 이후 조회/삭제에서 재사용
    client.global.set("imageRef", response.body.imageRef);

    // digest도 같이 저장해두면 digest 기준 삭제도 가능
    client.global.set("digestRef", response.body.digest);
%}

@imageRef = {{client.global.imageRef}}
@digestRef = {{client.global.digestRef}}

###
# ---------------------------------------------------------------------
# 3) (추가) 로컬 이미지 목록 조회 (전체)
# ---------------------------------------------------------------------
# @name listLocalImagesAll
GET {{host}}/api/docker/images
Accept: application/json

###
# ---------------------------------------------------------------------
# 4) (추가) 로컬 이미지 목록 조회 (필터: repo 부분 문자열)
#     예: demo/rex-repo
# ---------------------------------------------------------------------
# @name listLocalImagesFiltered
GET {{host}}/api/docker/images?containsRepo={{containsRepo}}
Accept: application/json

###
# ---------------------------------------------------------------------
# 5) (추가) 로컬 이미지 삭제 - repo:tag 기준
#     - pull 성공 후 저장된 imageRef 사용
# ---------------------------------------------------------------------
# @name deleteLocalImageByRef
DELETE {{host}}/api/docker/images
Content-Type: application/json
Accept: application/json

{
  "imageRef": "{{imageRef}}",
  "force": false
}

###
# ---------------------------------------------------------------------
# 6) (추가) 로컬 이미지 삭제 - digest 기준(선택)
#     - pull 성공 후 저장된 digestRef 사용
#     - digestRef가 null이면 실패할 수 있음(서버가 inspect 실패한 경우)
# ---------------------------------------------------------------------
# @name deleteLocalImageByDigest
DELETE {{host}}/api/docker/images
Content-Type: application/json
Accept: application/json

{
  "imageRef": "{{digestRef}}",
  "force": false
}
