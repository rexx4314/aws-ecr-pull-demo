###
# =====================================================================
# ECR Layer Stream Downloader - IntelliJ HTTP Client
# - 기능:
#   1) ECR repo 전체 + 최신 tag 조회
#   2) ECR 레이어 다운로드(스트리밍) + manifest/blobs 저장 + sha256 검증
# =====================================================================

###
# ---------------------------------------------------------------------
# 1) Repo 스캔
#   - pullable=true && latestTag!=null 인 repo만 자동 선택
# ---------------------------------------------------------------------
# @name scanReposWithLatestTag
POST {{host}}/api/ecr/scan
Content-Type: application/json
Accept: application/json

{
  "region": "{{region}}",
  "accountId": "{{accountId}}",
  "accessKeyId": "{{accessKeyId}}",
  "secretAccessKey": "{{secretAccessKey}}",
  "maxPages": 50,
  "maxImages": 2000
}

> {%
    if (response.body && response.body.code) {
        client.log("Scan failed. code=" + response.body.code + ", msg=" + response.body.message);
        client.log("details=" + JSON.stringify(response.body.details || {}));
        client.global.set("repositoryName", "");
        client.global.set("tag", "");
        client.global.set("scanOk", "false");
    } else {
        const items = (response.body && response.body.items) ? response.body.items : [];
        const candidates = items.filter(it => it && it.pullable === true && it.latestTag);

        if (candidates.length === 0) {
            client.log("No PULLABLE repos.");
            client.global.set("repositoryName", "");
            client.global.set("tag", "");
            client.global.set("scanOk", "false");
        } else {
            const picked = candidates[0];
            client.global.set("repositoryName", picked.repositoryName);
            client.global.set("tag", picked.latestTag);
            client.global.set("scanOk", "true");
            client.log("Picked repo=" + picked.repositoryName + ", tag=" + picked.latestTag);
        }
    }
%}

@repositoryName = {{client.global.repositoryName}}
@tag = {{client.global.tag}}
@scanOk = {{client.global.scanOk}}

###
# ---------------------------------------------------------------------
# 2) 레이어 다운로드
#   - scanOk=false 또는 repo/tag가 비면 호출 막음
# ---------------------------------------------------------------------
# @name downloadLayers
POST {{host}}/api/ecr/download
Content-Type: application/json
Accept: application/json

{
  "region": "{{region}}",
  "accountId": "{{accountId}}",
  "accessKeyId": "{{accessKeyId}}",
  "secretAccessKey": "{{secretAccessKey}}",
  "repositoryName": "{{repositoryName}}",
  "tag": "{{tag}}",

  "resolveLatest": false,
  "includeConfig": true,
  "verifySha256": true,

  "concurrency": 4,
  "maxRetries": 4,
  "httpTimeoutSeconds": 180,
  "outputDir": "./out",

  "maxPages": 50,
  "maxImages": 2000
}

> {%
    // scan 실패했으면 로그만 남김
    if (client.global.get("scanOk") !== "true") {
        client.log("⚠️ Skip download: scanOk is not true. repositoryName/tag is empty or scan failed.");
    }

    if (response.body && response.body.code) {
        client.log("Download failed. code=" + response.body.code + ", msg=" + response.body.message);
        client.log("details=" + JSON.stringify(response.body.details || {}));
    } else {
        client.log("resolvedTag=" + response.body.resolvedTag);
        client.log("resolvedDigest=" + response.body.resolvedDigest);
        client.log("layerCount=" + response.body.layerCount);
        client.log("downloadedCount=" + response.body.downloadedCount);
        client.log("outputPath=" + response.body.outputPath);
        client.log("manifestPath=" + response.body.manifestPath);
        client.log("configPath=" + response.body.configPath);
        client.log("message=" + response.body.message);
    }
%}
